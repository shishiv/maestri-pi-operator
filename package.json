{
  "name": "maestri-pi-operator",
  "version": "0.3.2",
  "description": "Native Maestri transport tools for Pi.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "mpo-extension": "./bin/mpo-extension"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./readiness": {
      "types": "./dist/readiness.d.ts",
      "default": "./dist/readiness.js"
    }
  },
  "files": [
    "README.md",
    "bin",
    "docs",
    "firstmate-extension.json",
    "resources",
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "presmoke": "npm run build",
    "smoke": "bash tests/smoke-v01.sh --fake",
    "presmoke:live": "npm run build",
    "smoke:live": "bash tests/smoke-v01.sh --live"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "^24.0.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
